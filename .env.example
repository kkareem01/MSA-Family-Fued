# Shared secret the host enters once in the control panel. Change it.
HOST_PIN=change-me
# Port the single server listens on (display, host, survey, buzzer, API, sockets)
PORT=3000
# SQLite file; created on first boot. Survives restarts mid-event.
DB_PATH=./data/feud.db
# Folder scanned for optional sound overrides (reveal.mp3, strike.mp3, ...)
SOUNDS_DIR=./sounds
# Optional: preset public URL (named tunnel / ngrok). Leave blank to let `npm run event` fill it in.
PUBLIC_URL=
# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info
# Set to true only when hosted behind a platform proxy (Railway, Fly.io, Render), so client IPs are read from x-forwarded-for.
TRUST_PROXY=false
